@model RaceDay.Mvc.Models.CreateCategoryViewModel

@{
    ViewData["Title"] = "Add Race Category";
}

<div class="container py-5">
    <h1 class="fw-bold">Add Race Category</h1>
    <p class="text-muted">
        Create a new race category for your event.
    </p>

    <form asp-controller="Organiser"
          asp-action="CreateCategory"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="EventId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control"
                   placeholder="e.g. 5 km Fun Run" />
            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DistanceKm" class="form-label"></label>
            <input asp-for="DistanceKm" class="form-control"
                   type="number" step="0.01" min="0.01" />
            <span asp-validation-for="DistanceKm"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EntryFee" class="form-label"></label>
            <input asp-for="EntryFee" class="form-control"
                   type="number" step="0.01" min="0" />
            <span asp-validation-for="EntryFee"
                  class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="MinAge" class="form-label"></label>
                <input asp-for="MinAge" class="form-control"
                       type="number" min="0" />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="MaxAge" class="form-label"></label>
                <input asp-for="MaxAge" class="form-control"
                       type="number" min="0" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="MaxEntries" class="form-label"></label>
            <input asp-for="MaxEntries" class="form-control"
                   type="number" min="1" />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Race Category
        </button>

        <a asp-controller="Organiser"
           asp-action="Events"
           class="btn btn-outline-secondary ms-2">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
