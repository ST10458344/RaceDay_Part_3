@model RaceDay.Mvc.Models.EditEventViewModel

@{
    ViewData["Title"] = "Edit Race Event";
}

<div class="container py-5">

    <h1 class="fw-bold">Edit Race Event</h1>

    <p class="text-muted">
        Update your race event details and publishing status.
    </p>

    <form asp-controller="Organiser"
          asp-action="EditEvent"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="EventId" />

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description"
                      class="form-control" rows="3"></textarea>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate"
                       type="date" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="StartTime" class="form-label"></label>
                <input asp-for="StartTime"
                       type="time" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="RouteDescription"
                   class="form-label"></label>
            <textarea asp-for="RouteDescription"
                      class="form-control" rows="3"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="MaxParticipants"
                   class="form-label"></label>
            <input asp-for="MaxParticipants"
                   type="number" min="1" class="form-control" />
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsPublished"
                   class="form-check-input" />
            <label asp-for="IsPublished"
                   class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-controller="Organiser"
           asp-action="Events"
           class="btn btn-outline-secondary ms-2">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
